# ============================================================
# soc-lab-v2 .gitignore — credential & artifact hygiene
# ============================================================

# Credentials & secrets — NEVER commit these
*.env
*.env.*
secrets.yml
secrets.yaml
creds.txt
passwords.txt
lab-creds.*

# Hashcat artifacts
*.pot
*.potfile
hashcat.potfile

# Wordlists — too large and contain sensitive data
wordlists/
*.txt.gz
rockyou.txt

# Wireshark / packet captures
*.pcap
*.pcapng
*.cap

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
*.log
logs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Temporary files
tmp/
temp/
*.tmp

# Evidence files — blocked by default, allowed in designated evidence folders
*.png
*.jpg
*.jpeg
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!README*.png
# Allow screenshots inside incident and threat-scenario evidence folders
!incidents/**/evidence/*.png
!incidents/**/evidence/*.jpg
!incidents/**/evidence/*.jpeg
!threat-scenarios/**/evidence/*.png
!threat-scenarios/**/evidence/*.jpg
!threat-scenarios/**/evidence/*.jpeg
